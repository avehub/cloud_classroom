# ==========================================
# 应用基础环境配置 (App Base Configuration)
# ==========================================
APP_ENV=pro
APP_KEY="change_me_to_random_32_chars"
APP_TIMEZONE="Asia/Shanghai"
APP_LOG_TRACE=false
APP_BASE_URI="/"
APP_STATIC_BASE_URI="/static/"
APP_STATIC_VERSION="20240901"

# 外部域名与 WebSocket 地址
SITE_DOMAIN="yourdomain.com"
# 站点基准地址（含协议，用于生成图片/分享等绝对地址，生产环境必填）
SITE_URL="https://yourdomain.com"
WEBSOCKET_CONNECT_ADDRESS="yourdomain.com:8282"
WEBSOCKET_REGISTER_ADDRESS="127.0.0.1:1238"

# ==========================================
# 数据库配置 (MySQL Configuration)
# ==========================================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD="change_me_mysql_root_pwd"
MYSQL_DATABASE=ctc
MYSQL_USER=ctc
MYSQL_PASSWORD="change_me_mysql_user_pwd"
MYSQL_CHARSET=utf8mb4

# ==========================================
# Redis 缓存配置 (Redis Configuration)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_INDEX=0
REDIS_PASSWORD="change_me_redis_pwd"

# ==========================================
# 阿里云短信服务 (Aliyun SMS Configuration)
# ==========================================
# AccessKey 建议使用 RAM 子账号，仅授权 AliyunDysmsFullAccess
SMS_ACCESS_KEY_ID=""
SMS_ACCESS_KEY_SECRET=""
SMS_SIGN_NAME=""
SMS_REGION="cn-hangzhou"

# 短信模板 Code（阿里云控制台申请通过后获得，留空表示停用）
SMS_TEMPLATE_VERIFY=""
SMS_TEMPLATE_ORDER_FINISH=""
SMS_TEMPLATE_REFUND_FINISH=""
SMS_TEMPLATE_GOODS_DELIVER=""
SMS_TEMPLATE_LIVE_BEGIN=""
SMS_TEMPLATE_CONSULT_REPLY=""

# ==========================================
# 点播播放票据 / 防盗链 (VOD Play Token)
# ==========================================
# 留空时回退到 APP_KEY；生产建议单独配置
PLAY_TOKEN_SECRET=""
# 播放地址 token 有效期（秒），应大于单节课时长
PLAY_TOKEN_LIFETIME=7200
# 是否绑定客户端 IP（移动网络切换可能导致播放中断，默认 false）
PLAY_TOKEN_BIND_IP=false
# 是否绑定 UA（默认 true）
PLAY_TOKEN_BIND_UA=true
# 是否绑定播放地址（默认 true；CDN 远程鉴权需回传原始 URI）
PLAY_TOKEN_BIND_URL=true
# 是否强制把播放地址升级为 HTTPS（默认 true）
PLAY_TOKEN_FORCE_HTTPS=true
# 额外允许保护的域名，逗号分隔；为空时使用后台点播分发域名
PLAY_TOKEN_PROTECT_HOSTS=""
