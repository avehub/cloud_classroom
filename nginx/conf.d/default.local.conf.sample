# 本地/开发环境站点配置模板（复制为 default.conf 使用）
#   http://local.example.com / http://localhost / http://127.0.0.1
# 生产 HTTPS 环境请使用 default.secure.conf.sample。

server {
    listen 80;
    server_name local.example.com localhost 127.0.0.1 ctc.docker;

    set $ctc_https off;

    include /etc/nginx/conf.d/app.locations.inc;
}
